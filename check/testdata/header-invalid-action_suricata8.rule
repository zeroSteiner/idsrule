# lint: dialect=suricata
# Suricata 8 action scopes and the config action, outside firewall rules.
drop:flow tcp any any -> any any (msg:"a"; sid:1; rev:1;)
pass:packet tcp any any -> any any (msg:"b"; sid:2; rev:1;)
reject:flow tcp any any -> any any (msg:"b2"; sid:10; rev:1;)
rejectsrc:packet tcp any any -> any any (msg:"b3"; sid:11; rev:1;)
config:packet dns any any -> any any (msg:"c"; dns.query; content:"x"; sid:3; rev:1;)
config dns any any -> any any (msg:"d"; dns.query; content:"y"; sid:4; rev:1;)
# expect: header-invalid-action error "drop takes the scope packet, flow, not "tx""
drop:tx tcp any any -> any any (msg:"e"; sid:5; rev:1;)
# expect: header-invalid-action error "alert takes no scope"
alert:flow tcp any any -> any any (msg:"f"; sid:6; rev:1;)
# expect: header-invalid-action error "accept is only valid in firewall rules (Policy.Firewall)"
accept:hook tcp any any -> any any (msg:"g"; sid:7; rev:1;)
# expect: header-invalid-action error "only a Suricata firewall rule lists several actions"
drop:flow,alert tcp any any -> any any (msg:"h"; sid:8; rev:1;)
# expect: header-invalid-action @+2 error "only a Suricata firewall rule lists several actions"
# expect: header-invalid-action error ""bogus" is not a suricata action"
drop:flow,bogus tcp any any -> any any (msg:"i"; sid:9; rev:1;)
