# lint: dialect=suricata
alert http any any -> any any (msg:"a"; metadata: deployment Datacenter, deployment SSLDecrypt; sid:1; rev:1;)
# expect: metadata-entry-dropped warning "metadata entry "variant" has no value; Suricata drops it"
alert http any any -> any any (msg:"b"; metadata: deployment Datacenter, deployment SSLDecrypt, variant; sid:2; rev:1;)
# expect: metadata-entry-dropped warning "empty metadata entry; Suricata drops it"
alert http any any -> any any (msg:"c"; metadata:created_at 2024_01_01, , updated_at 2024_01_02; sid:3; rev:1;)
# expect: metadata-entry-dropped warning "empty metadata entry"
alert http any any -> any any (msg:"d"; metadata:created_at 2024_01_01,; sid:4; rev:1;)
# expect: metadata-entry-dropped warning "separates its key and value with a tab"
alert http any any -> any any (msg:"e"; metadata:created_at	2024_01_01; sid:5; rev:1;)
# expect: metadata-entry-dropped @+2 "metadata entry "a" has no value"
# expect: metadata-entry-dropped "metadata entry "b" has no value"
alert http any any -> any any (msg:"f"; metadata:a, b ,c d; sid:6; rev:1;)
alert http any any -> any any (msg:"g"; metadata:key value with spaces,	tabbed key; sid:7; rev:1;)
