# Every shape the fix rewrites: several modifiers, a negated pattern, blanks
# around the comma and before the semicolon.
# expect: content-snort3-modifiers error fix
alert tcp any any -> any any (msg:"a"; content:"x", nocase, depth 5; sid:1; rev:1;)
# expect: content-snort3-modifiers error fix
alert tcp any any -> any any (msg:"b"; content:!"y", nocase; sid:2; rev:1;)
# expect: content-snort3-modifiers error fix
alert tcp any any -> any any (msg:"c"; content:"z" ,  offset 0 ,within 4 ; sid:3; rev:1;)
# expect: content-snort3-modifiers error fix
alert tcp any any -> any any (msg:"d"; content:"|00 01|", fast_pattern; sid:4; rev:1;)
