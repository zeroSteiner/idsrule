alert tcp any any -> any any (msg:"high"; sid:13000000; rev:1;)
alert tcp any any -> any any (msg:"low edge"; sid:12900000; rev:1;)
alert tcp any any -> any any (msg:"high edge"; sid:12999999; rev:1;)
alert tcp any any -> any any (msg:"placeholder"; sid:5; rev:1;)
