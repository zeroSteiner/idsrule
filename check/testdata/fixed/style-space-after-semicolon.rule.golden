# lint: space-after-semicolon=require
alert tcp any any -> any any (msg:"ok"; content:"x"; nocase; sid:1; rev:1;)
# expect: style-space-after-semicolon warning "missing space after ';'" fix
alert tcp any any -> any any (msg:"none"; sid:2; rev:1;)
# expect: style-space-after-semicolon warning ""  " after ';' where a single space is expected" fix
alert tcp any any -> any any (msg:"two"; sid:3; rev:1;)
# A semicolon followed by a line continuation, by ")" or by the end of the
# rule is exempt.
alert tcp any any -> any any (msg:"exempt"; \
    sid:4; rev:1; \
)
alert tcp any any -> any any (msg:"exempt"; sid:5; rev:1;  )
alert tcp any any -> any any (msg:"exempt";\
sid:6; rev:1;)
# A run of tokens that did not parse as an option is the syntax diagnostic's
# business, not a next option.
# expect: syntax-empty-option error
alert tcp any any -> any any (msg:"bad";;sid:7; rev:1;)
