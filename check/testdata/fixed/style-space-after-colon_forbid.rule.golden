# lint: space-after-colon=forbid
alert tcp any any -> any any (msg:"ok"; content:"x"; nocase; sid:1; rev:1;)
# expect: style-space-after-colon warning "whitespace after ':' where none is allowed" fix
alert tcp any any -> any any (msg:"one"; sid:2; rev:1;)
# expect: style-space-after-colon warning fix
alert tcp any any -> any any (msg:"two"; sid:3; rev:1;)
# A value that starts on the next line is exempt, with or without a blank
# before the backslash.
alert tcp any any -> any any (msg: \
    "continued"; sid:4; rev:1;)
