alert tcp $HOME_NET any -> $EXTERNAL_NET [80:90,!85,1024:] (msg:"vars and port list"; sid:1;)
alert ip ![10.0.0.0/8,10.1.0.0/16] any <> [$HOME_NET,[192.168.0.0/16, 172.16.0.0/12]] any (msg:"negated and nested lists"; sid:2;)
alert tcp [$HOME_NET, !10.0.0.5] [80, 443] -> any !53 (msg:"spaces after commas"; sid:3;)
